; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/updates_per_second=45

[application]

config/name="ProgrammeshanasProjekts2026"
run/main_scene="res://node_3d.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Constants="*res://tools/constants.gd"
SceneLoader="*res://tools/scene_loader.gd"
DialoguePlayer="*res://tools/dialogue_player.gd"
Progress="*res://tools/progress.gd"
SignalBus="*res://tools/signalBus.gd"
TestingAll="*res://Documents/Testing_All.gd"

[display]

window/size/viewport_width=1167
window/size/viewport_height=658
window/stretch/mode="viewport"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[global_group]

Player="just the guy"
SpeechPanel=""
Level=""

